<!-- See documentation at http://doc.nuxeo.com/x/HgIz -->
<package type="addon" name="nuxeo-labs-custom-workflow-graph" version="@VERSION@">
  <title>Nuxeo Labs Custom Workflow Graph</title>
  <description>
    <p>Replaces the "View Graph" dialog of Nuxeo Web UI with a modern workflow graph viewer:
    automatic layout, themed cards, current step highlighting, pan and zoom, and a details panel
    showing the open tasks (assignees, due date, instructions) of the current step.
    Web UI resources only, no server-side code.</p>
  </description>
  <vendor>Hyland</vendor>
  <installer restart="true" />
  <uninstaller restart="true" />
  <nuxeo-validation>none</nuxeo-validation>
  <production-state>testing</production-state>
  <supported>false</supported>
  <target-platform>
    <name>lts</name>
    <version>[@NUXEO_TARGET_VERSION@,)</version>
  </target-platform>
  <dependencies>
    <package>nuxeo-web-ui</package>
  </dependencies>
  <license>Apache License, Version 2.0</license>
  <license-url>http://www.apache.org/licenses/LICENSE-2.0</license-url>
  <visibility>DEV</visibility>
</package>
